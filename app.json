{
  "expo": {
    "name": "sage-app",
    "slug": "sage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E201B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.sageband.app",
      "infoPlist": {
        "NSFamilyControlsUsageDescription": "SAGE uses Screen Time to know when you cross your daily limit, so it can nudge you to take a break.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.family-controls": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E201B"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "T3NQVMQ5XP",
          "appGroup": "group.co.sageband.app"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "91dfdafb-23cc-472f-9f5a-f8d0e97936fe",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "co.sageband.app.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.co.sageband.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "co.sageband.app.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.co.sageband.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "co.sageband.app.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.co.sageband.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "sage12s-team"
  }
}
